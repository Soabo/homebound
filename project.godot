; Engine configuration file.
; Homebound – Godot 4.7

config_version=5

[application]

config/name="Homebound"
config/description="First-Person Survival Horror – Prototyp"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
TimeManager="*res://scripts/systems/time_manager.gd"
PowerManager="*res://scripts/systems/power_manager.gd"
Inventory="*res://scripts/systems/inventory.gd"
Survival="*res://scripts/systems/survival.gd"
Builder="*res://scripts/systems/builder.gd"
ThreatDirector="*res://scripts/systems/threat_director.gd"
GameState="*res://scripts/systems/game_state.gd"
GameInput="*res://scripts/core/game_input.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
